{
    "rules": {
        ".read": false,
        ".write": "auth != null",
        "news": {
            ".read": true,
            ".write": "auth != null"
        },
        "config": {
            ".write": "auth != null",
            "apiKeys": {
                ".read": "auth != null",
                ".write": "auth != null",
                "groq": {
                    ".read": true
                },
                "google_gemini": {
                    ".read": true
                }
            },
            "afip": {
                ".read": "auth != null",
                ".write": "auth != null"
            },
            "google": {
                ".read": "auth != null",
                ".write": "auth != null"
            },
            "$other": {
                ".read": true
            }
        },
        "appSettings": {
            ".read": true,
            ".write": "auth != null"
        },
        "datosId": {
            ".read": true,
            ".write": "auth != null"
        },
        "backups": {
            ".read": true,
            ".write": "auth != null"
        },
        "$precios_legacy": {
            ".read": "$precios_legacy.beginsWith('precios_legacy_v')",
            ".write": "auth != null"
        },
        "feriados_modificados": {
            ".read": true,
            ".write": "auth != null"
        },
        "feriados_recurrentes": {
            ".read": true,
            ".write": "auth != null"
        },
        "optionalServices": {
            ".read": true,
            ".write": "auth != null"
        },
        "serviceNames": {
            ".read": true,
            ".write": "auth != null"
        },
        "iaTexts": {
            ".read": true,
            ".write": "auth != null"
        },
        "floatingButtons": {
            ".read": true,
            ".write": "auth != null"
        },
        "componentOrder": {
            ".read": true,
            ".write": "auth != null"
        },
        "navbar": {
            ".read": true,
            ".write": "auth != null"
        },
        "siteStats": {
            ".read": true,
            ".write": "auth != null"
        },
        "newsStats": {
            ".read": true,
            ".write": "auth != null"
        },
        "newsStatus": {
            ".read": true,
            ".write": "auth != null"
        },
        "usage_logs": {
            ".read": "auth != null",
            ".write": "auth != null"
        },
        "feedback": {
            ".read": "auth != null",
            ".write": "auth != null"
        },
        "settings": {
            ".read": true,
            ".write": "auth != null"
        },
        "historialSueldos": {
            ".read": true,
            ".write": "auth != null"
        },
        "presupuestos": {
            ".read": true,
            ".write": "auth != null"
        },
        "presupuestos_por_id": {
            ".read": true,
            ".write": "auth != null"
        },
        "users": {
            "$uid": {
                ".read": "$uid === auth.uid || auth != null",
                ".write": "$uid === auth.uid || auth != null"
            }
        },
        "playground": {
            ".read": true,
            ".write": "auth != null"
        },
        "empleados": {
            ".read": "auth != null",
            ".write": "auth != null"
        },
        "sueldos_historial": {
            ".read": "auth != null",
            ".write": "auth != null"
        },
        "empleados_fotos": {
            ".read": "auth != null",
            ".write": "auth != null"
        },
        "gastos_empresa": {
            ".read": "auth != null",
            ".write": "auth != null"
        },
        "gastos_mensuales": {
            ".read": "auth != null",
            ".write": "auth != null"
        },
        "empleos": {
            "vacantes": {
                ".read": true,
                ".write": "auth != null"
            },
            "postulaciones": {
                ".read": true,
                "$postulacionId": {
                    ".write": "!data.exists() || auth != null"
                }
            }
        }
    }
}