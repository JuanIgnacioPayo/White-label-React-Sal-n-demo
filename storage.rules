rules_version = '2';
  service firebase.storage {
    match /b/{bucket}/o {
      match /knowledge_base/{allFiles=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
      match /images/{allImages=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
      // Rule for button icons
      match /button_icons/{buttonId} {
        allow write: if request.auth != null; // Allow authenticated users to write
        allow read: if true; // Allow anyone to read the icons
      }
      match /optional-services/{serviceId}/{allFiles=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
      match /external-services/{serviceId}/{allFiles=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
      match /empleados_fotos/{imageId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
      match /uploads/{allFiles=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }